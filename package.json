{
  "name": "sipbar-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node -r ./node24-patch.cjs node_modules/next/dist/bin/next dev",
    "build": "prisma generate && node -r ./node24-patch.cjs node_modules/next/dist/bin/next build",
    "start": "node -r ./node24-patch.cjs node_modules/next/dist/bin/next start",
    "lint": "next lint",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "node scripts/migrate-excel.mjs",
    "db:seed-users": "node scripts/seed-users.mjs",
    "db:extract": "node scripts/extract-excel-data.mjs",
    "db:migrate-excel": "node scripts/migrate-excel.mjs",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^5.21.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
