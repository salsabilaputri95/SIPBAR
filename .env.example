# =============================================================
# SIPBAR WEB - ENVIRONMENT VARIABLES CONFIGURATION
# =============================================================

# Mode Lingkungan (development / production)
NODE_ENV=production

# -------------------------------------------------------------
# Database PostgreSQL (Digunakan oleh Docker & Prisma)
# -------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sipbardb

# URL Koneksi Prisma Database:
# - Untuk Docker internal: postgresql://postgres:postgres@postgres:5432/sipbardb?schema=public
# - Untuk Lokal Dev (port default 5432): postgresql://postgres:postgres@localhost:5432/sipbardb?schema=public
# - Untuk Host koneksi ke Docker (port 5433): postgresql://postgres:postgres@localhost:5433/sipbardb?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sipbardb?schema=public"

# -------------------------------------------------------------
# Web Server & NextAuth Authentication
# -------------------------------------------------------------
# Port aplikasi di host (3001 agar tidak bentrok dengan web lain di port 3000)
APP_PORT=3001

# URL domain aplikasi.
# - Saat lokal/server tanpa domain: http://localhost:3001
# - Saat sudah pakai Ngrok: ganti dengan URL domain Ngrok (contoh: https://xxx.ngrok-free.app)
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=sipbar-bps-jeneponto-secret-key-2026-secure
